# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
HOST=localhost

# ============================================
# DATABASE - PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_RENDER_DB_PASSWORD_HERE
DB_NAME=bikeflow
DB_DIALECT=postgres
DB_LOGGING=true

# Sequelize Pool Settings
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_backend_jwt_secret_key_change_this
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRE=30d

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@bikeflow.com

# ============================================
# PAYMENT GATEWAYS
# ============================================
ESEWA_MERCHANT_ID=your_esewa_merchant_id
ESEWA_SECRET_KEY=your_esewa_secret
ESEWA_PAYMENT_URL=https://esewa.com.np/api/epay/main/v2/form
ESEWA_SUCCESS_URL=http://localhost:3000/payment/success
ESEWA_FAILURE_URL=http://localhost:3000/payment/failure

KHALTI_SECRET_KEY=your_khalti_secret
KHALTI_PUBLIC_KEY=your_khalti_public_key
KHALTI_PAYMENT_URL=https://khalti.com/api/v2/payment/initiate/
KHALTI_SUCCESS_URL=http://localhost:3000/payment/success
KHALTI_FAILURE_URL=http://localhost:3000/payment/failure

FONEPAY_MERCHANT_ID=your_fonepay_merchant_id
FONEPAY_SECRET_KEY=your_fonepay_secret
FONEPAY_PAYMENT_URL=https://api.fonepay.com/api/epay/main/v2/form
FONEPAY_SUCCESS_URL=http://localhost:3000/payment/success
FONEPAY_FAILURE_URL=http://localhost:3000/payment/failure

# ============================================
# SMS CONFIGURATION (Twilio)
# ============================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
SMS_FROM_NUMBER=+1234567890

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_RESEND_COOLDOWN=60

# ============================================
# GOOGLE MAPS
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_key

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
SHOP_DASHBOARD_URL=http://localhost:3000/shop/dashboard
CUSTOMER_APP_URL=http://localhost:3000/customer/dashboard

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/gif,application/pdf

# ============================================
# REFERRAL SYSTEM
# ============================================
REFERRAL_BONUS_AMOUNT=5.00
REFERRED_USER_BONUS=2.50
REFERRAL_CODE_LENGTH=8

# ============================================
# SECURITY
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX_REQUESTS=3

# ============================================
# FEATURES FLAGS
# ============================================
ENABLE_REFERRAL=true
ENABLE_SOS=true
ENABLE_PAYMENT=true
ENABLE_EMAIL=true
ENABLE_SMS=true

# ============================================
# ADMIN
# ============================================
ADMIN_EMAIL=admin@bikeflow.com
ADMIN_PASSWORD=Admin@123456

# ============================================
# API VERSION
# ============================================
API_VERSION=v1
API_PREFIX=/api/v1

# ============================================
# DEFAULTS
# ============================================
DEFAULT_CURRENCY=NPR
DEFAULT_LANGUAGE=en
DEFAULT_COUNTRY=NP
DEFAULT_TIMEZONE=Asia/Kathmandu
