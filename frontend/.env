# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
REACT_APP_API_URL=http://localhost:5000/api/v1
REACT_APP_WS_URL=ws://localhost:5001

# Google Maps (Frontend)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_key

# Payment Gateways (Public Keys)
REACT_APP_ESEWA_MERCHANT_ID=your_esewa_merchant_id
REACT_APP_KHALTI_PUBLIC_KEY=your_khalti_public_key
REACT_APP_FONEPAY_MERCHANT_ID=your_fonepay_merchant_id

# Auth
REACT_APP_JWT_STORAGE_KEY=bikeflow_token
REACT_APP_USER_STORAGE_KEY=bikeflow_user

# App Config
REACT_APP_APP_NAME=BikeFlow
REACT_APP_APP_VERSION=1.0.0
REACT_APP_DEFAULT_CURRENCY=NPR

# Feature Flags
REACT_APP_ENABLE_REFERRAL=true
REACT_APP_ENABLE_SOS=true
REACT_APP_ENABLE_PAYMENT=true

# Environment
REACT_APP_ENV=development
REACT_APP_DEBUG=true