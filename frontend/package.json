{
  "name": "motorcycle-rental-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "pnpm --filter web dev",
    "customer": "pnpm --filter mobile-customer start",
